<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <RootNamespace>Gurux.DLMS.Client.Example.Net</RootNamespace>
        <AssemblyName>Gurux.DLMS.Client.Example.Net</AssemblyName>
        <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
        <Deterministic>false</Deterministic>
        <DefaultItemExcludes>$(DefaultItemExcludes);packages\**</DefaultItemExcludes>
    </PropertyGroup>
    <ItemGroup>
        <Compile Remove="Tests\**\*.cs" />
        <PackageReference Include="Gurux.DLMS.DeviceAccess" Version="1.0.2611.1801" />
        <PackageReference Include="Gurux.Net" Version="9.0.2611.1802" />
        <PackageReference Include="Gurux.Serial" Version="9.0.2611.1803" />
    </ItemGroup>
    <ItemGroup>
        <Compile Update="Properties\Resources.Designer.cs">
            <DesignTime>True</DesignTime>
            <AutoGen>True</AutoGen>
            <DependentUpon>Resources.resx</DependentUpon>
        </Compile>
        <EmbeddedResource Update="Properties\Resources.resx">
            <Generator>ResXFileCodeGenerator</Generator>
            <LastGenOutput>Resources.Designer.cs</LastGenOutput>
        </EmbeddedResource>
    </ItemGroup>
</Project>
